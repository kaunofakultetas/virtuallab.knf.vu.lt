{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc && tsc-alias",
        "build-scripts": "tsc -p tsconfig.scripts.build.json && tsc-alias -p tsconfig.scripts.build.json",
        "create-admin": "node dist-scripts/scripts/createAdmin.js",
        "hash-password": "node dist-scripts/scripts/hashPassword.js",
        "render-access": "node dist-scripts/scripts/renderAccessConfiguration.js",
        "render-gateway": "node dist-scripts/scripts/renderGatewayConfiguration.js",
        "set-gateway-settings": "node dist-scripts/scripts/setGatewayRuntimeSettings.js",
        "preflight-network-tokens": "node dist-scripts/scripts/preflightNetworkProxmoxTokens.js",
        "apply-network-vnets": "node dist-scripts/scripts/applyNetworkVnets.js",
        "apply-gateway-policy": "node dist-scripts/scripts/applyGatewayPolicy.js",
        "apply-access-policy": "node dist-scripts/scripts/applyAccessPolicy.js",
        "apply-access-trunk": "node dist-scripts/scripts/applyAccessTrunk.js",
        "release-network-group": "node dist-scripts/scripts/releaseNetworkGroup.js",
        "create-admin:dev": "ts-node -r tsconfig-paths/register scripts/createAdmin.ts",
        "hash-password:dev": "ts-node -r tsconfig-paths/register scripts/hashPassword.ts",
        "render-access:dev": "ts-node -r tsconfig-paths/register scripts/renderAccessConfiguration.ts",
        "render-gateway:dev": "ts-node -r tsconfig-paths/register scripts/renderGatewayConfiguration.ts",
        "set-gateway-settings:dev": "ts-node -r tsconfig-paths/register scripts/setGatewayRuntimeSettings.ts",
        "preflight-network-tokens:dev": "ts-node -r tsconfig-paths/register scripts/preflightNetworkProxmoxTokens.ts",
        "apply-network-vnets:dev": "ts-node -r tsconfig-paths/register scripts/applyNetworkVnets.ts",
        "apply-access-policy:dev": "ts-node -r tsconfig-paths/register scripts/applyAccessPolicy.ts",
        "apply-access-trunk:dev": "ts-node -r tsconfig-paths/register scripts/applyAccessTrunk.ts",
        "release-network-group:dev": "ts-node -r tsconfig-paths/register scripts/releaseNetworkGroup.ts",
        "start": "node dist/index.js",
        "dev": "node --watch ./node_modules/ts-node/dist/bin.js --files -r tsconfig-paths/register src/index.ts",
        "typecheck-scripts": "tsc -p tsconfig.scripts.json",
        "test": "node --test -r ts-node/register -r tsconfig-paths/register test/*.test.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@types/cookie-parser": "^1.4.9",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.20.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-loki": "^3.0.0",
        "pino-pretty": "^13.1.3",
        "prom-client": "^15.1.3",
        "samlify": "^2.13.1",
        "toad-scheduler": "^4.0.1",
        "undici": "^8.2.0",
        "zod": "^4.4.3"
    }
}
