# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000                        # Port the HTTP server listens on (default: 3000)

# Set to the host IP only in test environments to serve the application over HTTP.
# Leave unset in production.
# CADDY_IP_HTTP_HOST=172.16.0.34

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=backend_db
# Set only when running the backend outside the root Compose stack.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/backend_db

# ── JWT ───────────────────────────────────────────────────────────────────────
BACKEND_JWT_SECRET=change-me-to-a-long-random-secret

# ── Proxmox ───────────────────────────────────────────────────────────────────
# The isolated backend reaches Proxmox through the root Compose exit service.
PROXMOX_BASE_URL=https://exit:8006/api2/json
PROXMOX_NODE_NAME=pve
# API token in the form  user@realm!tokenid=secret
PROXMOX_AUTH_TOKEN=root@pam!mytoken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Network reconciliation uses separate least-privilege identities. The observer
# requires SDN.Audit; the mutator requires SDN.Allocate, SDN.Audit, and SDN.Use.
PROXMOX_NETWORK_OBSERVER_AUTH_TOKEN=virtual-lab-network@pve!observer=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_NETWORK_MUTATOR_AUTH_TOKEN=virtual-lab-network@pve!mutator=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Required while exit:8006 forwards the Proxmox self-signed certificate.
# Replace with false after installing a certificate trusted for the chosen endpoint.
PROXMOX_TLS_INSECURE=true

# ── Guacamole ─────────────────────────────────────────────────────────────────
# The isolated backend reaches Guacamole through the root Compose exit service.
GUACAMOLE_URL=http://exit:8080
# Public-facing URL sent to the browser for session links (defaults to GUACAMOLE_URL if unset)
GUACAMOLE_PUBLIC_URL=https://virtuallab.example.edu/guac
GUACAMOLE_USER=replace-with-guacamole-user
GUACAMOLE_PASS=replace-with-a-long-random-password
# Set to "true" to skip TLS certificate verification
GUACAMOLE_TLS_INSECURE=false

# ── SAML SSO (optional — omit SAML_SP_ENTITY_ID to disable SSO) ───────────────
# SAML_SP_ENTITY_ID=https://virtuallab.knf.vu.lt/api/auth/saml/metadata
# SAML_ACS_URL=https://virtuallab.knf.vu.lt/api/auth/sso/callback
# SAML_SP_KEY_PATH=/run/secrets/saml-sp.key     # path to PEM private key
# SAML_SP_CERT_PATH=/run/secrets/saml-sp.cert   # path to PEM certificate
# IdP metadata is always fetched live from https://sso.vu.lt/SSO/saml2/idp/metadata.php

# ── Access observation ────────────────────────────────────────────────────────
# Read-only observation of Access LXC 200 (Guacamole), used by reconciliation
# dry-runs and as the independent channel every Access apply proves itself
# through. It reaches a dedicated forced command on the Proxmox host, which runs
# the guest-side observer with `pct exec`; the orchestrator never gets a shell.
# ACCESS_OBSERVER_HOST=10.10.10.1
# ACCESS_OBSERVER_PORT=22
# ACCESS_OBSERVER_USER=root
# ACCESS_OBSERVER_IDENTITY_FILE=/run/secrets/access-observer.key
# ACCESS_OBSERVER_KNOWN_HOSTS_FILE=/run/secrets/access-observer.known_hosts
# The forced command in authorized_keys is what actually constrains this key;
# the value below only has to be non-empty for a forced-command principal.
# ACCESS_OBSERVER_COMMAND=virtual-lab-access-observe

# ── Access guest policy apply ─────────────────────────────────────────────────
# Writes the rendered nftables/sysctl/networkd files inside LXC 200. A SEPARATE
# key from the observer, so it can be revoked independently and so a commit is
# never authorised by the session that made the change.
# ACCESS_APPLIER_HOST=10.10.10.1
# ACCESS_APPLIER_PORT=22
# ACCESS_APPLIER_USER=root
# ACCESS_APPLIER_IDENTITY_FILE=/run/secrets/access-applier.key
# ACCESS_APPLIER_KNOWN_HOSTS_FILE=/run/secrets/access-applier.known_hosts
# ACCESS_APPLIER_COMMAND=virtual-lab-access-apply

# ── Access VLAN trunk apply ───────────────────────────────────────────────────
# Reconciles LXC 200's VLAN trunk. Separate from the policy applier above
# because it mutates a different thing: `pct set` and `bridge vlan` on the
# Proxmox host, never anything inside the container.
# ACCESS_TRUNK_APPLIER_HOST=10.10.10.1
# ACCESS_TRUNK_APPLIER_PORT=22
# ACCESS_TRUNK_APPLIER_USER=root
# ACCESS_TRUNK_APPLIER_IDENTITY_FILE=/run/secrets/access-trunk-applier.key
# ACCESS_TRUNK_APPLIER_KNOWN_HOSTS_FILE=/run/secrets/access-trunk-applier.known_hosts
# ACCESS_TRUNK_APPLIER_COMMAND=virtual-lab-access-trunk-apply

# ── Gateway observation (optional) ────────────────────────────────────────────
# Read-only observation of Gateway VM 202, used by network reconciliation
# dry-runs. It reaches a dedicated forced command on the Proxmox host, which in
# turn runs the guest-side observer inside the VM; the orchestrator never gets a
# shell on either. Omit the block entirely to run without Gateway checks — the
# dry-run then simply reports none rather than failing.
# GATEWAY_OBSERVER_HOST=10.10.10.1
# GATEWAY_OBSERVER_PORT=22
# GATEWAY_OBSERVER_USER=root
# GATEWAY_OBSERVER_IDENTITY_FILE=/run/secrets/gateway-observer.key
# GATEWAY_OBSERVER_KNOWN_HOSTS_FILE=/run/secrets/gateway-observer.known_hosts
# The forced command in authorized_keys is what actually constrains this key;
# the value below only has to be non-empty for a forced-command principal.
# GATEWAY_OBSERVER_COMMAND=virtual-lab-gateway-observe

# ── Gateway apply (optional) ──────────────────────────────────────────────────
# The mutating counterpart to the observer above, used only by
# `npm run apply-gateway-policy`. It is a SEPARATE key with its own forced
# command so it can be revoked independently, and so that an apply proves
# convergence over a different connection than the one that made the change.
# There is no HTTP apply path; leaving this unset simply makes the CLI refuse.
# GATEWAY_APPLIER_HOST=10.10.10.1
# GATEWAY_APPLIER_PORT=22
# GATEWAY_APPLIER_USER=root
# GATEWAY_APPLIER_IDENTITY_FILE=/run/secrets/gateway-applier.key
# GATEWAY_APPLIER_KNOWN_HOSTS_FILE=/run/secrets/gateway-applier.known_hosts
# GATEWAY_APPLIER_COMMAND=virtual-lab-gateway-apply
