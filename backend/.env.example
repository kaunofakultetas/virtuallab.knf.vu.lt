# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000                        # Port the HTTP server listens on (default: 3000)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/virtual_lab

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret

# ── Proxmox ───────────────────────────────────────────────────────────────────
PROXMOX_BASE_URL=https://proxmox-host:8006/api2/json
PROXMOX_NODE_NAME=pve
# API token in the form  user@realm!tokenid=secret
PROXMOX_AUTH_TOKEN=root@pam!mytoken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Set to "true" to skip TLS certificate verification (self-signed certs)
PROXMOX_TLS_INSECURE=false

# ── Guacamole ─────────────────────────────────────────────────────────────────
# Internal URL used by the backend to talk to Guacamole
GUACAMOLE_URL=http://10.10.10.50:8080
# Public-facing URL sent to the browser for session links (defaults to GUACAMOLE_URL if unset)
GUACAMOLE_PUBLIC_URL=https://guac.example.com
GUACAMOLE_USER=guacadmin
GUACAMOLE_PASS=guacadmin
# Set to "true" to skip TLS certificate verification
GUACAMOLE_TLS_INSECURE=false
