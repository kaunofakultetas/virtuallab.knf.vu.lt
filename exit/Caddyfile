{
	layer4 {
		:443 {
			@exit_logs tls sni logs.knf.vu.lt
			route @exit_logs {
				proxy logs.knf.vu.lt:443
			}

			@exit_vu_sso tls sni sso.vu.lt
			route @exit_vu_sso {
				proxy sso.vu.lt:443
			}
		}

		# Proxmox API — blind TCP forward, no SNI (raw IP backend).
		# PROXMOX_HOST_ADDRESS differs per host, so it is supplied from .env
		# rather than baked in: a hardcoded address here silently points one
		# deployment's control plane at the other's Proxmox, which presents as
		# 401 on every API call rather than as a connection failure.
		:8006 {
			route {
				proxy {$PROXMOX_HOST_ADDRESS}:8006
			}
		}

		# Restricted Access observer SSH; the server forces a read-only command.
		:2222 {
			route {
				proxy {$PROXMOX_HOST_ADDRESS}:22
			}
		}

		# Guacamole — plain HTTP, no SNI; set GUACAMOLE_URL=http://exit:8080 in .env
		:8080 {
			route {
				proxy 10.10.10.50:8080
			}
		}
	}
}
